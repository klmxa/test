local function nearbyParrying()
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then
        return {}
    end

    local folder = workspace:FindFirstChild("PlayersCharacters")
    if not folder then
        return {}
    end

    local out = {}
    for _, char in ipairs(folder:GetChildren()) do
        if char ~= myChar then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and isParryingChar(char) then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist <= 60 then
                    out[#out + 1] = string.format("%s (%.0f)", char.Name, dist)
                end
            end
        end
    end
    return out
end

