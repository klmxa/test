-- ============ состояние IsParrying ============
local since = setmetatable({}, {__mode = "k"}) -- flag -> момент, когда стало true

local function getFlag(char)
    if not char then return nil end
    local ci = FindFirstChild(char, "CharacterInformation")
    local flag = ci and FindFirstChild(ci, "IsParrying")
    if flag and IsA(flag, "BoolValue") then
        return flag
    end
    return nil
end

local function isParryingChar(char)
    local flag = getFlag(char)
    if not flag or flag.Value ~= true then
        return false
    end
    local t = since[flag]
    if not t then
        t = os.clock()
        since[flag] = t
    end
    return (os.clock() - t) <= PARRY_WINDOW
end

local function trackFlags()
    local folder = workspace:FindFirstChild("PlayersCharacters")
    if not folder then return end
    for _, char in ipairs(folder:GetChildren()) do
        local flag = getFlag(char)
        if flag then
            if flag.Value == true then
                if not since[flag] then since[flag] = os.clock() end
            else
                since[flag] = nil
            end
        end
    end
end

-- ============ HOOK ============
-- Вся логика в заменяемой функции. БЕЗ namecall-вызовов внутри.
getgenv().MM_AntiParryCheck = function(self, targetArg)
    if self.ClassName ~= "RemoteEvent" or self.Name ~= "hit" then
        return false
    end
    local tool = self.Parent
    local myChar = LP.Character
    if not tool or not myChar or tool.ClassName ~= "Tool" or not IsDescendantOf(tool, myChar) then
        return false
    end
    if typeof(targetArg) ~= "Instance" or targetArg.ClassName ~= "Humanoid" then
        return false
    end

    local char = targetArg.Parent
    if isParryingChar(char) then
        Cfg.Blocked = Cfg.Blocked + 1
        Cfg.LastBlockedAt = os.clock()
        Cfg.LastTarget = char and char.Name or "?"
        return true
    end

    Cfg.Passed = Cfg.Passed + 1
    return false
end

if not getgenv().MM_AntiParryHookV2 then
    getgenv().MM_AntiParryHookV2 = true

    local oldNC
    oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and Cfg.Enabled then
            local check = getgenv().MM_AntiParryCheck
            if check then
                local ok, block = pcall(check, self, ...)
                if ok and block then
                    return nil
                end
            end
            -- на случай, если что-то выше затронуло namecall-состояние
            if setnamecallmethod then
                setnamecallmethod(method)
            end
        end
        return oldNC(self, ...)
    end))
end

