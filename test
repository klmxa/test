local nextUpdate = 0
getgenv().MM_AntiParryLoop = RunService.Heartbeat:Connect(function()
    trackFlags() -- каждый кадр: фиксируем момент включения IsParrying

    local now = os.clock()
    if now < nextUpdate then
        return
    end
    nextUpdate = now + 0.1

    local list = nearbyParrying()
    if now - Cfg.LastBlockedAt < 0.45 then
        status.Text = "BLOCKED HIT: " .. tostring(Cfg.LastTarget)
        status.TextColor3 = Color3.fromRGB(200, 120, 255)
        stroke.Color = Color3.fromRGB(140, 80, 220)
    elseif not Cfg.Enabled then
        status.Text = "OFF — hits go through"
        status.TextColor3 = Color3.fromRGB(150, 150, 160)
        stroke.Color = Color3.fromRGB(60, 60, 70)
    elseif #list > 0 then
        status.Text = "PARRY: " .. table.concat(list, ", ")
        status.TextColor3 = Color3.fromRGB(200, 120, 255)
        stroke.Color = Color3.fromRGB(140, 80, 220)
    else
        status.Text = "ARMED — waiting for parry"
        status.TextColor3 = Color3.fromRGB(80, 200, 130)
        stroke.Color = Color3.fromRGB(60, 60, 70)
    end

    sub.Text = "blocked: " .. tostring(Cfg.Blocked) .. " | passed: " .. tostring(Cfg.Passed) .. " | in parry: " .. tostring(#list)
end)

